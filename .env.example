# EmailJS Configuration
# Sign up at https://www.emailjs.com/ and obtain your credentials:
# 1. Service ID from "Email Services"
# 2. Template ID from "Email Templates" (General Contact Form)
# 3. Appointment Template ID (Appointment Confirmations)
# 4. Public Key from "Account" -> "API Keys" -> "Public Key"

VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_APPOINTMENT_TEMPLATE_ID=your_appointment_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
